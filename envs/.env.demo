# basic
ENV=dev
DEBUG=true

# postgresql
POSTGRES_USER=your_user
POSTGRES_PW=change_it
POSTGRES_DB=postgres_or_new_db
PGADMIN_MAIL=your@email.com
PGADMIN_PW=change_it

DATABASE_URL=sqlite:///./dev.db

# redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=my_pwd

# JWT
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=360000
JWT_KEY=use_secrets_module_to_generate_this_key
JWT_ALGO=HS256
