# postgresql
POSTGRES_USER=jack
POSTGRES_PW=jack123
# default db is postgres
POSTGRES_DB=postgres_or_new_db
#postgresql+psycopg2://<USER>:<PASSWORD>@<HOST>:<PORT>/<DBNAME>
# postgres 监听0.0.0.0, 使用docker-desktop时，写Windows的IPV4
DATABASE_URL=postgresql+psycopg2://jack:jack123@192.168.1.200:5432/postgres_or_new_db

# redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=123456

# JWT
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=360000
JWT_KEY=use_secrets_module_to_generate_this_key
JWT_ALGO=HS256
